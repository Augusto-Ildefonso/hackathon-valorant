# Copy to `.env` (git-ignored) in the repo root. The backend reads it at startup; restart `make dev` after editing.
# Optional LLM narrator for the Action Plan. Leave everything unset to run fully rule-based.
VAVAGYM_LLM=1
# Google AI Studio key (https://aistudio.google.com/apikey):
GEMINI_API_KEY=
# Or an Anthropic key instead:
# ANTHROPIC_API_KEY=
# Optional: VAVAGYM_LLM_PROVIDER=gemini|anthropic   VAVAGYM_LLM_MODEL=gemini-2.5-flash
